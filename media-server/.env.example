# Run `python3 manage.py init` to create a private .env with a random qBittorrent password.
PUID=1000
PGID=1000
TZ=Asia/Jerusalem
MEDIA_DIR=/srv/media
# init replaces ${HOME} with an absolute path so sudo Docker uses the same state.
CONFIG_DIR=${HOME}/.local/state/media-server
BACKUP_DIR=${HOME}/.local/state/media-server-backups
BIND_ADDRESS=0.0.0.0

# Quote credentials, especially passwords containing $, spaces, or #.
QBITTORRENT_USERNAME='admin'
QBITTORRENT_PASSWORD=''

# Create an API key after completing Jellyfin's first-run wizard.
JELLYFIN_API_KEY=''

# Image defaults in compose.yaml pin the working versions by digest.
# Override an image deliberately to upgrade it, for example:
# JELLYFIN_IMAGE=jellyfin/jellyfin:latest
