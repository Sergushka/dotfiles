{
  "languages": {
    "Python": {
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
      },
      "formatter": {
        "language_server": {
          "name": "ruff",
        },
      },
      "language_servers": ["ty", "ruff", "!basedpyright"],
      "format_on_save": "off",
    },
  },
  "edit_predictions": {
    "provider": "ollama",
    "mode": "subtle"
  },
  "show_edit_predictions": false,
  "agent": {
    "threads_sidebar": {
      "position": "right"
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "disable_ai": false,
  "cli_default_open_behavior": "new_window",
  "agent_servers": {
    "codex-acp": {
      "type": "registry",
    },
  },
  "base_keymap": "Cursor",
  "theme": "Omazed",
  "buffer_font_size": 15,
  "autosave": "off",
  "vim_mode": true,
  "vim": {
    "use_smartcase_find": true,
    "toggle_relative_line_numbers": true,
    "highlight_on_yank_duration": 200,
  },
  "lsp": {
    "rust-analyzer": {
      "settings": {
        "checkOnSave": true,
        "check": {
          "command": "clippy",
        },
      },
    },
  },
}
