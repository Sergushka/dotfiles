[
  {
    "context": "Workspace",
    "bindings": {
      "cmd-shift-e": "workspace::ToggleRightDock",
      "cmd-shift-b": "workspace::ToggleLeftDock",
      "cmd-shift-t": "terminal_panel::Toggle",
    },
  },
  {
    "context": "vim_mode == normal && !menu",
    "bindings": {
      "space f": "file_finder::Toggle",
      "space w": "workspace::Save",
      "space q": "pane::CloseActiveItem",
      "space x": "pane::CloseActiveItem",
      "space t": "terminal_panel::Toggle",
      "space e": "workspace::ToggleRightDock",
      "space g": ["task::Spawn", { "task_name": "Lazygit" }],
      "shift-j": "workspace::ActivatePaneDown",
    },
  },
  {
    "context": "vim_mode == visual && !menu",
    "bindings": {
      // Visual bindings
      "shift-j": "editor::MoveLineDown",
      "shift-k": "editor::MoveLineUp",
    },
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      // Vim normal + visual mode
    },
  },
  {
    "context": "EmptyPane || SharedScreen",
    "bindings": {
      // Put key bindings here (in addition to the context above) if you want them to
      // work when no editor exists.
      "space f": "file_finder::Toggle",
    },
  },
  {
    "context": "Dock",
    "bindings": {
      "ctrl-w h": "workspace::ActivatePaneLeft",
      "ctrl-w l": "workspace::ActivatePaneRight",
      "ctrl-w k": "workspace::ActivatePaneUp",
      "ctrl-w j": "workspace::ActivatePaneDown",
    },
  },
]
